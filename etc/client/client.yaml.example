application:
  client:
    server_endpoint: "https://server.cmn.local:8443"
    tls:
      ca_file:   etc/common/root.crt
      cert_file: etc/client/client.crt
      key_file:  etc/client/client.key

postgresql:
  host:    localhost
  port:    5432
  user:    cmnweave
  pass:    secret
  dbname:  cmnweave
  sslmode: require
